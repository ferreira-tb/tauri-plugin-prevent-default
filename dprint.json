{
  "indentWidth": 2,
  "lineWidth": 120,
  "newLineKind": "lf",
  "useTabs": false,
  "json": {
    "array.preferSingleLine": true,
    "object.preferSingleLine": false,
    "packageJson.applyConventions": true,
  },
  "toml": {
    "cargo.applyConventions": true
  },
  "excludes": ["**/LICENSE"],
  "plugins": [
    "npm:@dprint/json@0.25.2",
    "npm:@dprint/markdown@0.26.0",
    "npm:@dprint/toml@0.9.0",
    "npm:dprint-plugin-yaml@0.6.0"
  ]
}
